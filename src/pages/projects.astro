---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects" description="Open-source projects and things I've built.">
  <div class="mx-auto max-w-page px-6 pt-12 pb-20">
    <header class="mb-12 max-w-[640px]">
      <span class="mb-3 block font-mono text-xs font-medium tracking-[0.08em] text-muted uppercase">Open source</span>
      <h1 class="mb-3.5 font-serif text-[3rem] leading-[1.08] font-medium tracking-[-0.025em] text-ink-900">Projects</h1>
      <p class="m-0 text-lg leading-[1.6] text-muted">Things I've built and maintain in the open.</p>
    </header>

    <div class="font-serif text-faint italic">
      <p>Coming soon.</p>
    </div>
  </div>
</BaseLayout>
