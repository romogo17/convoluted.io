---
import PostLayout from '../../layouts/PostLayout.astro';
import { getPosts, renderPost } from '../../lib/posts';

export async function getStaticPaths() {
  const sorted = await getPosts();

  return sorted.map((post, i) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: {
      post,
      nextPost: sorted[i + 1] ?? undefined,
    },
  }));
}

const { post, nextPost } = Astro.props;
const { Content } = await renderPost(post);
---

<PostLayout post={post} nextPost={nextPost}>
  <Content />
</PostLayout>
