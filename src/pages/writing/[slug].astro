---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return sorted.map((post, i) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: {
      post,
      nextPost: sorted[i + 1] ?? undefined,
    },
  }));
}

const { post, nextPost } = Astro.props;
const { Content } = await render(post);
---

<PostLayout post={post} nextPost={nextPost}>
  <Content />
</PostLayout>
