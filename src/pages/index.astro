---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();

const featuredPost = posts.find(p => p.data.featured) ?? posts[0];
const gridPosts = posts.filter(p => p.id !== featuredPost?.id);

function postHref(post: typeof posts[0]) {
  return `/writing/${post.id.replace(/\.(md|mdx)$/, '')}`;
}

const newsletterEnabled = import.meta.env.PUBLIC_NEWSLETTER_ENABLED === 'true';
---

<BaseLayout title="convoluted.io">
  <!-- Hero -->
  <section class="px-6 pt-14 pb-12 text-center">
    <div class="mx-auto max-w-[760px]">
      <div class="mb-[18px] inline-flex items-center gap-[9px] font-mono text-[13px] tracking-[0.08em] text-green-600 uppercase">
        <img src="/logo-mark.svg" width="16" height="10" alt="" aria-hidden="true" />
        engineering, untangled
      </div>

      <h1 class="mb-[18px] font-serif text-[clamp(2.25rem,6vw,3.5rem)] leading-[1.04] font-medium tracking-[-0.025em] text-balance text-ink-900">
        Most systems aren't hard.<br />
        They're just <em class="text-green-600 italic">tangled</em>.
      </h1>

      <p class="mx-auto mb-[26px] max-w-[560px] text-[1.1875rem] leading-[1.6] text-muted">
        Field notes on platform engineering, distributed systems, and the deploys that keep you up
        at night, pulled apart one thread at a time.
      </p>

      {newsletterEnabled && (
        <>
          <form
            class="mx-auto flex max-w-[420px] gap-2 max-sm:flex-col"
            action="https://buttondown.com/api/emails/embed-subscribe/convoluted.io"
            method="post"
            data-newsletter
          >
            <div class="relative flex flex-1 items-center">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 shrink-0 pointer-events-none text-faint" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <input
                type="email"
                name="email"
                placeholder="you@domain.dev"
                aria-label="Email address"
                class="h-10 w-full rounded-md border-[1.5px] border-paper-400 bg-surface-raised pr-3 pl-[38px] font-sans text-sm text-body transition-[border-color,box-shadow] duration-150 ease-brand focus:border-accent focus:shadow-focus focus:outline-none"
                required
              />
            </div>
            <button type="submit" class="h-10 rounded-md border-none bg-accent px-[18px] font-sans text-sm font-semibold whitespace-nowrap text-paper-50 transition-[background,transform] duration-150 ease-brand hover:bg-accent-hover active:translate-y-px max-sm:w-full">Subscribe</button>
          </form>
          <p class="mt-[11px] mb-0 min-h-[1.2em] font-mono text-[12.5px] text-faint empty:hidden data-[state=error]:text-[#c0392b]" data-newsletter-status role="status" aria-live="polite"></p>
          <p class="mt-[11px] mb-0 font-mono text-[12.5px] text-faint">~2 posts a month · no spam · unsubscribe anytime</p>
        </>
      )}
    </div>
  </section>

  <div class="mx-auto max-w-page px-6 pb-12">
    <!-- Featured post -->
    {featuredPost && (
      <div class="mb-12">
        <a href={postHref(featuredPost)} class="group grid grid-cols-[1.25fr_1fr] overflow-hidden rounded-lg border-[1.5px] border-green-200 bg-surface-card text-inherit no-underline shadow-sm transition-[box-shadow,border-color] duration-200 ease-brand hover:border-green-300 hover:no-underline hover:shadow-lg max-sm:grid-cols-1">
          <div class="flex flex-col px-8 py-[30px]">
            <div class="mb-3.5 flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-[5px] rounded-full border border-green-200 bg-green-100 px-2.5 py-[3px] font-mono text-[11px] font-semibold tracking-[0.04em] text-green-700 uppercase before:size-1.5 before:shrink-0 before:rounded-full before:bg-green-500 before:content-['']">Featured</span>
              {featuredPost.data.tags.slice(0, 2).map(t => (
                <span class="font-mono text-[11.5px] text-ink-600">#{t}</span>
              ))}
            </div>
            <h2 class="mb-3 font-serif text-[clamp(1.5rem,3vw,2.125rem)] leading-[1.1] font-medium tracking-[-0.02em] text-balance text-ink-900">{featuredPost.data.title}</h2>
            <p class="mb-5 flex-1 text-base leading-[1.6] text-body">{featuredPost.data.description}</p>
            <span class="inline-flex h-[38px] items-center gap-[7px] self-start rounded-md bg-accent px-4 font-sans text-sm font-semibold text-paper-50 transition-colors duration-150 ease-brand group-hover:bg-accent-hover">
              Read the post
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </div>
          <div class="relative flex min-h-[180px] items-center justify-center overflow-hidden bg-[linear-gradient(150deg,var(--color-green-600),var(--color-green-800))] max-sm:min-h-[120px]" aria-hidden="true">
            <img src="/knot-motif.svg" class="w-[115%] opacity-85 brightness-0 invert" width="320" height="64" alt="" />
            <span class="absolute right-5 bottom-[18px] font-mono text-xs text-white/75">
              {featuredPost.data.minutesRead ?? '—'} min · {featuredPost.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
            </span>
          </div>
        </a>
      </div>
    )}

    <!-- Post grid -->
    {gridPosts.length > 0 && (
      <section>
        <h2 class="mb-5 font-serif text-2xl font-medium text-ink-900">Latest writing</h2>

        <div class="grid grid-cols-[repeat(auto-fill,minmax(320px,1fr))] gap-5">
          {gridPosts.map(post => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              minutesRead={post.data.minutesRead ?? 1}
              href={postHref(post)}
            />
          ))}
        </div>
      </section>
    )}

    {posts.length === 0 && (
      <div class="px-6 py-16 text-center text-muted">
        <p>No posts yet. The first one is almost ready.</p>
        <p class="font-serif text-faint italic">It's simpler than it looks, promise.</p>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  import "../scripts/newsletter";
</script>
