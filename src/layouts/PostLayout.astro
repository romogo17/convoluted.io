---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { ArrowLeft, Bookmark, Share2 } from '@lucide/astro';

interface Props {
  post: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'> | undefined;
}

const { post, nextPost } = Astro.props;
const { title, description, pubDate, tags, minutesRead, lastModified } = post.data;

const dateStr = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const lastModifiedStr = lastModified
  ? new Date(lastModified).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const nextSlug = nextPost ? `/writing/${nextPost.id.replace(/\.(md|mdx)$/, '')}` : null;
---

<BaseLayout title={title} description={description}>
  <article class="article">
    <!-- Article header -->
    <div class="article__header">
      <a href="/" class="article__back">
        <ArrowLeft size={15} />
        All writing
      </a>

      <div class="article__tags">
        {tags.map(t => <span class="article__tag">{t}</span>)}
      </div>

      <h1 class="article__title">{title}</h1>

      {description && (
        <p class="article__dek">{description}</p>
      )}

      <div class="article__byline">
        <span class="article__avatar" aria-hidden="true">RM</span>
        <div class="article__byline-text">
          <span class="article__author">Roberto Mora</span>
          <span class="article__date-read">
            <time datetime={pubDate.toISOString()}>{dateStr}</time>
            {minutesRead && <> · {minutesRead} min read</>}
            {lastModifiedStr && lastModifiedStr !== dateStr && (
              <> · Updated {lastModifiedStr}</>
            )}
          </span>
        </div>
        <div class="article__byline-actions">
          <button class="article__action-btn" aria-label="Save">
            <Bookmark size={15} />
            Save
          </button>
          <button class="article__action-btn" aria-label="Share">
            <Share2 size={15} />
            Share
          </button>
        </div>
      </div>
    </div>

    <!-- Article body -->
    <div class="prose article__body">
      <slot />
    </div>

    <!-- Article footer -->
    <div class="article__footer">
      <div class="article__footer-tags">
        {tags.map(t => <span class="article__tag">{t}</span>)}
      </div>

      <!-- Author bio -->
      <div class="author-bio">
        <span class="author-bio__avatar" aria-hidden="true">RM</span>
        <div>
          <div class="author-bio__name">Roberto Mora</div>
          <div class="author-bio__handle">@romogo17</div>
          <p class="author-bio__bio">
            Platform engineer who has been on call for one too many database incidents. I write
            convoluted.io to turn hard-won 3am lessons into something you can read with your
            morning coffee.
          </p>
        </div>
      </div>

      <!-- Read next -->
      {nextPost && (
        <div class="read-next">
          <span class="eyebrow">Read next</span>
          <a
            href={nextSlug ?? '#'}
            class="read-next__card"
          >
            <div>
              <div class="read-next__title">{nextPost.data.title}</div>
              <div class="read-next__meta">
                {nextPost.data.minutesRead ?? '—'} min · {nextPost.data.tags[0]}
              </div>
            </div>
            <ArrowLeft size={20} style="transform: rotate(180deg); color: var(--color-green-600);" />
          </a>
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: var(--container-prose);
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  .article__header { padding-top: 32px; }

  .article__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 26px;
    transition: color 120ms var(--ease-out);
  }
  .article__back:hover { color: var(--text-strong); text-decoration: none; }

  .article__tags {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .article__tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-green-700);
    background: var(--color-green-50);
    border: 1px solid var(--color-green-100);
    border-radius: 999px;
    padding: 3px 10px;
    letter-spacing: 0.01em;
  }

  .article__title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.08;
    color: var(--text-strong);
    letter-spacing: -0.025em;
    font-weight: 500;
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .article__dek {
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    line-height: 1.5;
    color: var(--text-muted);
    font-style: italic;
    margin: 0 0 24px;
  }

  .article__byline {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  .article__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-green-100);
    color: var(--color-green-800);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    flex-shrink: 0;
  }

  .article__byline-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.3;
  }

  .article__author {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text-strong);
  }

  .article__date-read {
    font-size: 13px;
    color: var(--text-faint);
  }

  .article__byline-actions {
    margin-left: auto;
    display: flex;
    gap: 6px;
  }

  .article__action-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    padding: 0 10px;
    background: var(--surface-raised);
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    border: 1.5px solid var(--border-default);
    border-radius: 8px;
    cursor: pointer;
    transition: background 120ms var(--ease-out), color 120ms var(--ease-out);
  }
  .article__action-btn:hover { background: var(--surface-sunken); color: var(--text-strong); }

  .article__body {
    padding-top: 28px;
  }

  .article__footer {
    margin-top: 40px;
  }

  .article__footer-tags {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .author-bio {
    display: flex;
    gap: 16px;
    padding: 22px;
    background: var(--color-green-50);
    border: 1px solid var(--color-green-100);
    border-radius: 16px;
    margin-bottom: 32px;
  }

  .author-bio__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-green-200);
    color: var(--color-green-800);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    flex-shrink: 0;
  }

  .author-bio__name {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-strong);
    margin-bottom: 2px;
  }

  .author-bio__handle {
    font-size: 13.5px;
    color: var(--color-green-700);
    font-family: var(--font-mono);
    margin-bottom: 8px;
  }

  .author-bio__bio {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-body);
    margin: 0;
  }

  .read-next { }

  .read-next .eyebrow {
    display: block;
    margin-bottom: 10px;
  }

  .read-next__card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border: 1px solid var(--border-default);
    border-radius: 16px;
    background: var(--surface-card);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  .read-next__card:hover { box-shadow: var(--shadow-md); border-color: var(--color-green-200); text-decoration: none; color: inherit; }

  .read-next__title {
    font-family: var(--font-serif);
    font-size: 19px;
    color: var(--text-strong);
    margin-bottom: 3px;
  }

  .read-next__meta {
    font-size: 13.5px;
    color: var(--text-muted);
  }
</style>
