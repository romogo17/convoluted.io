---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { ArrowLeft, Share2, Check } from '@lucide/astro';

interface Props {
  post: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'> | undefined;
}

const { post, nextPost } = Astro.props;
const { title, description, pubDate, tags, minutesRead, lastModified } = post.data;

const dateStr = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const lastModifiedStr = lastModified
  ? new Date(lastModified).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const nextSlug = nextPost ? `/writing/${nextPost.id.replace(/\.(md|mdx)$/, '')}` : null;

const slug = post.id.replace(/\.(md|mdx)$/, '');
const ogImage = new URL(`/og/${slug}.png`, Astro.site ?? Astro.url.origin).toString();
// Use Astro.url.pathname so the JSON-LD URL matches the canonical BaseLayout emits (trailing slash included)
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  dateModified: lastModified ? new Date(lastModified).toISOString() : pubDate.toISOString(),
  author: { '@type': 'Person', name: 'Roberto Mora', url: 'https://convoluted.io/about' },
  url: canonicalURL,
  keywords: tags.join(', '),
  publisher: { '@type': 'Organization', name: 'convoluted.io', url: 'https://convoluted.io' },
});

const tagPill = 'inline-block rounded-full border border-green-100 bg-green-50 px-2.5 py-[3px] font-mono text-xs font-medium tracking-[0.01em] text-green-700';
---

<BaseLayout title={title} description={description} ogType="article" ogImage={ogImage} author="Roberto Mora">
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    <meta property="article:author" content="https://convoluted.io/about" />
    {tags.map(t => <meta property="article:tag" content={t} />)}
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <article class="mx-auto max-w-prose px-6 pb-20 lg:max-w-[60rem] lg:px-10 xl:max-w-[65rem] xl:px-12">
    <!-- Article header -->
    <div class="pt-8">
      <a href="/" class="mb-[26px] inline-flex items-center gap-1.5 text-sm font-semibold text-muted no-underline transition-colors duration-150 ease-brand hover:text-ink-900 hover:no-underline">
        <ArrowLeft size={15} />
        All writing
      </a>

      <div class="mb-4 flex flex-wrap gap-[7px]">
        {tags.map(t => <span class={tagPill}>{t}</span>)}
      </div>

      <h1 class="mb-4 font-serif text-[clamp(2rem,5vw,2.75rem)] leading-[1.08] font-medium tracking-[-0.025em] text-balance text-ink-900">{title}</h1>

      {description && (
        <p class="mb-6 font-serif text-[1.3125rem] leading-[1.5] text-muted italic">{description}</p>
      )}

      <div class="flex flex-wrap items-center gap-3 border-b border-paper-300 pb-[22px]">
        <span class="inline-flex size-[38px] shrink-0 items-center justify-center rounded-full bg-green-100 font-mono text-[11px] font-semibold text-green-800" aria-hidden="true">RM</span>
        <div class="flex flex-col gap-0.5 leading-[1.3]">
          <span class="text-[14.5px] font-semibold text-ink-900">Roberto Mora</span>
          <span class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] text-faint">
            <time datetime={pubDate.toISOString()}>{dateStr}</time>
            {lastModifiedStr && lastModifiedStr !== dateStr && (
              <span class="opacity-70">(Updated {lastModifiedStr})</span>
            )}
            {minutesRead && <span class="before:mr-1.5 before:content-['·']">{minutesRead} min read</span>}
          </span>
        </div>
        <div class="ml-auto flex gap-1.5">
          <button
            class="group inline-flex h-[30px] items-center gap-[5px] rounded-[8px] border-[1.5px] border-paper-400 bg-surface-raised px-2.5 font-sans text-[13px] font-semibold text-muted transition-colors duration-150 ease-brand hover:bg-surface-sunken hover:text-ink-900 data-[copied]:text-green-700 data-[copied]:hover:text-green-700"
            data-share
            aria-label="Share this post"
          >
            <span class="inline-flex items-center group-data-[copied]:hidden" data-share-icon>
              <Share2 size={15} />
            </span>
            <span class="hidden items-center text-green-600 group-data-[copied]:inline-flex" data-share-done aria-hidden="true">
              <Check size={15} />
            </span>
            <span data-share-label>Share</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Article body -->
    <div class="prose prose-brand max-w-none pt-7">
      <slot />
    </div>

    <!-- Article footer -->
    <div class="mt-10">
      <div class="mb-7 flex flex-wrap gap-[7px]">
        {tags.map(t => <span class={tagPill}>{t}</span>)}
      </div>

      <!-- Author bio -->
      <div class="mb-8 flex gap-4 rounded-lg border border-green-100 bg-green-50 p-[22px]">
        <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-green-200 font-mono text-[13px] font-semibold text-green-800" aria-hidden="true">RM</span>
        <div>
          <div class="mb-0.5 text-base font-bold text-ink-900">Roberto Mora</div>
          <div class="mb-2 font-mono text-[13.5px] text-green-700">@romogo17</div>
          <p class="m-0 text-[14.5px] leading-[1.6] text-body">
            Platform engineer who has been on call for one too many database incidents. I write
            convoluted.io to turn hard-won 3am lessons into something you can read with your
            morning coffee.
          </p>
        </div>
      </div>

      <!-- Read next -->
      {nextPost && (
        <div>
          <span class="mb-2.5 block font-mono text-xs font-medium tracking-[0.08em] text-muted uppercase">Read next</span>
          <a
            href={nextSlug ?? '#'}
            class="flex items-center gap-3 rounded-lg border border-paper-400 bg-surface-card px-[18px] py-4 text-inherit no-underline transition-[box-shadow,border-color] duration-200 ease-brand hover:border-green-200 hover:no-underline hover:shadow-md"
          >
            <div>
              <div class="mb-[3px] font-serif text-[19px] text-ink-900">{nextPost.data.title}</div>
              <div class="text-[13.5px] text-muted">
                {nextPost.data.minutesRead ?? '—'} min · {nextPost.data.tags[0]}
              </div>
            </div>
            <ArrowLeft size={20} class="rotate-180 text-green-600" />
          </a>
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<script>
  // Share button: native share sheet where available (mobile), copy-link
  // fallback everywhere else. The button confirms inline for 2s, no libraries.
  const btn = document.querySelector<HTMLButtonElement>("[data-share]");
  const label = btn?.querySelector<HTMLElement>("[data-share-label]");

  btn?.addEventListener("click", async () => {
    const url = window.location.href;
    const title = document.title;

    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {
        // user dismissed the share sheet; nothing to do
      }
      return;
    }

    try {
      await navigator.clipboard.writeText(url);
      const original = label?.textContent ?? "Share";
      btn.dataset.copied = "";
      if (label) label.textContent = "Link copied";
      setTimeout(() => {
        delete btn.dataset.copied;
        if (label) label.textContent = original;
      }, 2000);
    } catch {
      // clipboard blocked (e.g. insecure context); leave the button unchanged
    }
  });
</script>
