---
import { Rss, Mail } from '@lucide/astro';

const pathname = Astro.url.pathname;
const isWriting = pathname === '/' || pathname.startsWith('/writing');
const isAbout = pathname.startsWith('/about');

const newsletterEnabled = import.meta.env.PUBLIC_NEWSLETTER_ENABLED === 'true';
---

<header class="sticky top-0 z-[100] border-b border-paper-300 bg-surface-page/82 backdrop-blur-[10px] backdrop-saturate-[1.4]">
  <div class="mx-auto flex max-w-page items-center gap-7 px-6 py-[13px] max-[600px]:gap-4">
    <a href="/" class="inline-flex shrink-0 items-center gap-2.5 no-underline" aria-label="convoluted.io home">
      <img src="/logo-mark.svg" width="40" height="24" alt="" />
      <span class="font-serif text-[20px] leading-none font-medium tracking-[-0.02em] text-ink-900 max-[600px]:hidden"
        >convoluted<span class="text-green-600">.io</span></span
      >
    </a>

    <nav class="ml-2 flex items-center gap-5 max-[600px]:ml-0 max-[600px]:gap-3.5" aria-label="Primary">
      <a
        href="/"
        class="relative px-0.5 py-1.5 font-sans text-[15px] font-semibold text-muted no-underline transition-colors duration-150 ease-brand hover:text-ink-900 aria-[current=page]:text-green-700 aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-0.5 aria-[current=page]:after:h-0.5 aria-[current=page]:after:rounded-full aria-[current=page]:after:bg-green-500 aria-[current=page]:after:content-['']"
        aria-current={isWriting ? 'page' : undefined}>Writing</a
      >
      <a
        href="/about"
        class="relative px-0.5 py-1.5 font-sans text-[15px] font-semibold text-muted no-underline transition-colors duration-150 ease-brand hover:text-ink-900 aria-[current=page]:text-green-700 aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-0.5 aria-[current=page]:after:h-0.5 aria-[current=page]:after:rounded-full aria-[current=page]:after:bg-green-500 aria-[current=page]:after:content-['']"
        aria-current={isAbout ? 'page' : undefined}>About</a
      >
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <a
        href="/rss.xml"
        class="inline-flex size-[34px] items-center justify-center rounded-[9px] text-muted no-underline transition-colors duration-150 ease-brand hover:bg-surface-sunken hover:text-ink-900"
        aria-label="RSS feed"
      >
        <Rss size={18} />
      </a>
      {newsletterEnabled && (
        <a
          href="/about#subscribe"
          class="inline-flex h-8 items-center gap-1.5 rounded-[9px] bg-accent px-3 font-sans text-[13px] font-semibold text-paper-50 no-underline transition-[background,transform] duration-150 ease-brand hover:bg-accent-hover hover:text-paper-50 hover:no-underline active:translate-y-px max-[480px]:w-[34px] max-[480px]:justify-center max-[480px]:px-0"
        >
          <Mail size={15} />
          <span class="max-[480px]:hidden">Subscribe</span>
        </a>
      )}
    </div>
  </div>
</header>
