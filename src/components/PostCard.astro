---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  minutesRead: number;
  href: string;
  featured?: boolean;
}

const { title, description, pubDate, tags, minutesRead, href, featured = false } = Astro.props;

const dateStr = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<a
  href={href}
  class:list={[
    'flex flex-col rounded-lg border border-paper-400 bg-surface-card p-6 text-inherit no-underline shadow-xs transition-[transform,box-shadow,border-color] duration-200 ease-brand hover:-translate-y-[3px] hover:border-green-200 hover:shadow-lg',
    { 'border-green-200 bg-[color-mix(in_srgb,var(--color-surface-card)_60%,var(--color-green-50)_40%)]': featured },
  ]}
>
  <div class="mb-3 flex items-center gap-2">
    <div class="flex flex-1 gap-1.5">
      {tags.slice(0, 2).map(t => <span class="font-mono text-[11.5px] tracking-[0.01em] text-ink-600">#{t}</span>)}
    </div>
    <span class="inline-flex items-center rounded-full border border-slate-100 bg-slate-100 px-[9px] py-[3px] font-mono text-[11.5px] font-semibold whitespace-nowrap text-slate-700">{minutesRead} min</span>
  </div>

  <h3 class="mb-2 text-[23px] leading-[1.18] font-medium tracking-[-0.015em] text-balance text-ink-900 font-serif">{title}</h3>
  <p class="m-0 flex-1 text-[14.5px] leading-[1.55] text-muted">{description}</p>

  <div class="mt-4 flex items-center gap-[9px]">
    <span class="inline-flex size-[26px] shrink-0 items-center justify-center rounded-full bg-green-100 font-mono text-[10px] font-semibold text-green-800" aria-hidden="true">RM</span>
    <span class="text-[13px] text-muted">Roberto Mora</span>
    <span class="text-paper-400" aria-hidden="true">·</span>
    <time class="text-[13px] text-faint" datetime={pubDate.toISOString()}>{dateStr}</time>
  </div>
</a>
