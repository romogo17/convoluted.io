---

---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__body">
      <div class="site-footer__brand">
        <a href="/" class="logo" aria-label="convoluted.io home">
          <img src="/logo-mark.svg" width="40" height="24" alt="" />
          <span class="logo__wordmark"
            >convoluted<span class="logo__dot">.io</span></span
          >
        </a>
        <p class="site-footer__tagline">
          An engineering blog about the messy middle of systems — platform
          engineering, distributed systems, and the deploys that keep you up at
          night. We untangle it so the next person doesn't have to.
        </p>
      </div>

      <div class="site-footer__cols">
        <div class="footer-col">
          <span class="footer-col__title">Writing</span>
          <a href="/">Latest</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
        </div>
        <div class="footer-col">
          <span class="footer-col__title">Elsewhere</span>
          <a
            href="https://github.com/romogo17"
            rel="noopener noreferrer"
            target="_blank">GitHub</a
          >
          <a href="/rss.xml">RSS</a>
          <a href="/about#subscribe">Email</a>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>© {new Date().getFullYear()} convoluted.io</span>
      <span>built in the open · made with curiosity</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    margin-top: 64px;
    background: var(--surface-card);
  }

  .site-footer__inner {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 40px 24px 28px;
  }

  .site-footer__body {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    justify-content: space-between;
  }

  .site-footer__brand {
    max-width: 320px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .logo__wordmark {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--text-strong);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .logo__dot {
    color: var(--color-green-600);
  }

  .site-footer__tagline {
    font-size: 14px;
    color: var(--text-muted);
    margin-top: 12px;
    line-height: 1.6;
  }

  .site-footer__cols {
    display: flex;
    gap: 48px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col__title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 2px;
  }

  .footer-col a {
    font-size: 14px;
    color: var(--text-body);
    text-decoration: none;
    transition: color 120ms var(--ease-out);
  }

  .footer-col a:hover {
    color: var(--text-strong);
    text-decoration: none;
  }

  .site-footer__bottom {
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
  }
</style>
