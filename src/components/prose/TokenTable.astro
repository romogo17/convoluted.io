---
const tokens = [
  {
    prefix: 'ghp_',
    name: 'Classic PAT',
    lifespan: 'User-set expiry',
    purpose: 'Legacy credential tied to a human (or service) user. What you\'re replacing.',
    flow: 'legacy',
  },
  {
    prefix: 'github_pat_…',
    name: 'Fine-grained PAT',
    lifespan: 'User-set expiry',
    purpose: 'Scoped PAT, still user-tied. Better than classic, but unsupported on many enterprise billing APIs.',
    flow: 'legacy',
  },
  {
    prefix: 'eyJ…',
    name: 'JWT',
    lifespan: 'Max 10 min',
    purpose: 'Signed with the app\'s private key (RS256). Used only to call the Apps API to get an installation token. Never used for resource API calls.',
    flow: 'app-f1',
  },
  {
    prefix: 'ghs_…',
    name: 'Installation Access Token',
    lifespan: '1 hour',
    purpose: 'What your automation actually uses. Scoped to one installation, one set of permissions.',
    flow: 'app-f1',
  },
  {
    prefix: 'ghu_…',
    name: 'User Access Token',
    lifespan: '8h (expiry enabled) / no expiry (expiry disabled)',
    purpose: 'GitHub App acting on behalf of a user. Doubly constrained by the app\'s installed permissions AND the user\'s own access.',
    flow: 'app-f2',
  },
  {
    prefix: 'ghr_…',
    name: 'Refresh Token',
    lifespan: '6 months',
    purpose: 'Renews an expired user access token without re-authorization. Only issued when token expiry is enabled on the app.',
    flow: 'app-f2',
  },
  {
    prefix: 'gho_…',
    name: 'OAuth App Token',
    lifespan: 'No expiry by default',
    purpose: 'Classic OAuth App token. Scoped by OAuth scopes, not fine-grained permissions. What gh CLI issues.',
    flow: 'oauth',
  },
];

const flowLabels: Record<string, string> = {
  legacy: 'Legacy',
  'app-f1': 'App: Flow 1',
  'app-f2': 'App: Flow 2',
  oauth: 'OAuth App',
};

const flowRowBg: Record<string, string> = {
  legacy: 'bg-slate-100',
  'app-f1': 'bg-green-50',
  'app-f2': 'bg-amber-100',
  oauth: 'bg-clay-100',
};

const flowPrefixColor: Record<string, string> = {
  legacy: 'text-slate-700',
  'app-f1': 'text-green-700',
  'app-f2': 'text-amber-700',
  oauth: 'text-clay-700',
};

const flowBadge: Record<string, string> = {
  legacy: 'bg-[rgba(63,106,208,0.1)] text-slate-700 border-[rgba(63,106,208,0.2)]',
  'app-f1': 'bg-green-100 text-green-700 border-green-200',
  'app-f2': 'bg-[rgba(217,148,43,0.15)] text-amber-700 border-[rgba(217,148,43,0.25)]',
  oauth: 'bg-[rgba(198,85,60,0.1)] text-clay-700 border-[rgba(198,85,60,0.2)]',
};

const filters = [
  { key: 'all', label: 'All' },
  { key: 'app-f1', label: 'App: Flow 1' },
  { key: 'app-f2', label: 'App: Flow 2' },
  { key: 'oauth', label: 'OAuth App' },
  { key: 'legacy', label: 'Legacy' },
];
---

<div class="my-7">
  <div class="mb-3.5 flex flex-wrap gap-1.5" role="group" aria-label="Filter by token flow">
    {filters.map(f => (
      <button
        class="inline-flex h-7 items-center rounded-full border-[1.5px] border-paper-400 bg-surface-raised px-3 font-sans text-[12.5px] font-semibold text-muted transition-[background,color,border-color] duration-150 ease-brand hover:border-green-300 hover:text-ink-900 data-[active]:border-green-800 data-[active]:bg-green-800 data-[active]:text-paper-50 data-[active]:hover:border-green-800 data-[active]:hover:text-paper-50"
        data-filter={f.key}
        data-active={f.key === 'all' ? true : undefined}
        type="button"
      >
        {f.label}
      </button>
    ))}
  </div>

  <div class="flex flex-col gap-1.5">
    {tokens.map(t => (
      <div
        class:list={[
          'flex items-start gap-[14px] rounded-md px-3.5 py-3 max-[480px]:flex-col max-[480px]:gap-1.5 [&[hidden]]:hidden',
          flowRowBg[t.flow],
        ]}
        data-flow={t.flow}
      >
        <div class="w-[124px] shrink-0 pt-0.5 max-[480px]:w-auto">
          <code class:list={['!border-none !bg-transparent !p-0 font-mono text-xs font-semibold', flowPrefixColor[t.flow]]}>{t.prefix}</code>
        </div>
        <div class="min-w-0 flex-1">
          <div class="mb-[3px] flex flex-wrap items-center gap-2">
            <span class="text-sm font-semibold text-ink-900">{t.name}</span>
            <span class:list={['rounded-full border px-2 py-0.5 font-mono text-[11px] font-medium tracking-[0.01em]', flowBadge[t.flow]]}>
              {flowLabels[t.flow]}
            </span>
          </div>
          <div class="mb-1 font-mono text-[11.5px] text-faint">Lifespan: {t.lifespan}</div>
          <div class="text-[13.5px] leading-[1.55] text-body">{t.purpose}</div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const rows = document.querySelectorAll<HTMLElement>('[data-flow]');

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter ?? 'all';

      filters.forEach(b => {
        if (b === btn) {
          b.setAttribute('data-active', '');
        } else {
          b.removeAttribute('data-active');
        }
      });

      rows.forEach(row => {
        const visible = key === 'all' || row.dataset.flow === key;
        if (visible) {
          row.removeAttribute('hidden');
        } else {
          row.setAttribute('hidden', '');
        }
      });
    });
  });
</script>
