---
interface Props {
  filename?: string;
  lang?: string;
  animate?: boolean;
}

const { filename, lang = 'bash', animate = false } = Astro.props;
---

<figure class:list={['terminal', { 'terminal--animate': animate }]} data-lang={lang}>
  <div class="terminal__bar" aria-hidden="true">
    <span class="terminal__dot terminal__dot--red"></span>
    <span class="terminal__dot terminal__dot--yellow"></span>
    <span class="terminal__dot terminal__dot--green"></span>
    {filename && <span class="terminal__filename">{filename}</span>}
  </div>
  <div class="terminal__body">
    <slot />
  </div>
</figure>

<style>
  @keyframes terminal-in {
    from { opacity: 0; transform: translateY(12px) scale(0.99); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes line-reveal {
    from { opacity: 0; transform: translateX(-6px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .terminal {
    margin: 1.75rem 0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-md, 0 2px 4px rgba(40,34,22,.05), 0 6px 16px rgba(40,34,22,.08));
    border: 1px solid rgba(255,255,255,0.06);
    font-size: 0;  /* collapse whitespace between bar and body */
  }

  .terminal--animate {
    animation: terminal-in 400ms var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
  }

  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: #151f18;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .terminal__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .terminal__dot--red    { background: #FF5F57; }
  .terminal__dot--yellow { background: #FEBC2E; }
  .terminal__dot--green  { background: #28C840; }

  .terminal__filename {
    margin-left: 8px;
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    color: rgba(230, 233, 226, 0.55);
    flex: 1;
    text-align: center;
    letter-spacing: 0.01em;
  }

  .terminal__body {
    background: var(--code-bg, #1E2A22);
    padding: 18px 20px;
    overflow-x: auto;
    font-size: 14px;        /* reset from parent 0 */
  }

  /* Style code/pre slotted inside */
  .terminal__body :global(pre) {
    margin: 0;
    padding: 0;
    background: none;
    box-shadow: none;
    border-radius: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--code-fg, #E6E9E2);
  }

  .terminal__body :global(code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: var(--code-fg, #E6E9E2);
    font-family: var(--font-mono, monospace);
  }

  /* Line-by-line reveal when inside an animated terminal */
  .terminal--animate :global(.line) {
    display: block;
    animation: line-reveal 300ms var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)) both;
  }
  .terminal--animate :global(.line:nth-child(1))  { animation-delay: 100ms; }
  .terminal--animate :global(.line:nth-child(2))  { animation-delay: 180ms; }
  .terminal--animate :global(.line:nth-child(3))  { animation-delay: 260ms; }
  .terminal--animate :global(.line:nth-child(4))  { animation-delay: 340ms; }
  .terminal--animate :global(.line:nth-child(5))  { animation-delay: 420ms; }
  .terminal--animate :global(.line:nth-child(6))  { animation-delay: 500ms; }
  .terminal--animate :global(.line:nth-child(7))  { animation-delay: 580ms; }
  .terminal--animate :global(.line:nth-child(8))  { animation-delay: 660ms; }
  .terminal--animate :global(.line:nth-child(9))  { animation-delay: 740ms; }
  .terminal--animate :global(.line:nth-child(10)) { animation-delay: 820ms; }
</style>
