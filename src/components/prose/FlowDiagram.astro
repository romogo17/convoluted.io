---
interface Props {
  caption?: string;
  label?: string;
}
const { caption, label = 'Flow diagram' } = Astro.props;
---

<figure class="my-7 overflow-hidden rounded-[12px] bg-paper-200 px-6 py-5 [&_svg]:block [&_svg]:h-auto [&_svg]:w-full" aria-label={label}>
  <slot />
  {caption && <figcaption class="mt-2.5 text-center text-sm text-faint">{caption}</figcaption>}
</figure>
