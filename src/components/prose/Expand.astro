---
import { ChevronRight } from '@lucide/astro';

interface Props {
  title?: string;
}
const { title = 'Show more' } = Astro.props;
---

<details class="group my-5 overflow-hidden rounded-md border border-paper-300 bg-surface-card">
  <summary class="flex list-none items-center gap-[7px] px-3.5 py-2.5 font-sans text-sm font-semibold text-muted transition-[color,background] duration-150 ease-brand marker:hidden select-none hover:bg-surface-sunken hover:text-ink-900 [&::-webkit-details-marker]:hidden">
    <span class="inline-flex shrink-0 items-center transition-transform duration-200 ease-brand group-open:rotate-90" aria-hidden="true">
      <ChevronRight size={13} />
    </span>
    <span class="leading-none">{title}</span>
  </summary>
  <div class="border-t border-paper-300 px-3.5 [&>*:first-child]:mt-3.5 [&>*:last-child]:mb-3.5">
    <slot />
  </div>
</details>
